{
  "openapi": "3.1.1",
  "info": {
    "title": "WarehouseAPI | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7219"
    },
    {
      "url": "http://localhost:5282"
    }
  ],
  "paths": {
    "/goods": {
      "post": {
        "tags": [
          "Goods"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddGoodsDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AddGoodsDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AddGoodsDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddGoodsDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "article": {
            "type": [
              "null",
              "string"
            ]
          },
          "barcode": {
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "vat": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "float"
          },
          "minStock": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "float"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          },
          "shelf": {
            "type": [
              "null",
              "string"
            ]
          },
          "bundle": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "float"
          },
          "bunit": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Goods"
    }
  ]
}